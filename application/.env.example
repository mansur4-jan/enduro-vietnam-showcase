# Production PostgreSQL. Empty = private local PGlite bridge.
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=https://enduro-vietnam.com
APP_HTTPS=1
# Keep disabled for local/staging. No real messages without explicit recipient configuration.
DELIVERY_ENABLED=0
RESEND_API_KEY=
EMAIL_FROM=
OWNER_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional first bootstrap only; keep outside version control.
OWNER_PASSWORD=

# Private staging only: set both, and set NEXT_PUBLIC_SITE_URL to the staging origin.
STAGING_USER=
STAGING_PASSWORD=
